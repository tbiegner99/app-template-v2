# Firebase — obtain service account JSON from Firebase Console > Project Settings > Service Accounts
# Paste the minified JSON as a single line value
FIREBASE_CREDENTIALS_JSON=
# Your Firebase project ID (visible in Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=

SUPERTOKENS_CONNECTION_URI=https://your-instance.supertokens.io
SUPERTOKENS_API_KEY=your_api_key
API_DOMAIN=http://localhost:8080
WEBSITE_DOMAIN=http://localhost:8000

# System-actor key for POST /signup — lets you bootstrap the first admin
# user (or script user creation) without an existing session. Send it as
# the X-System-Actor-Key header. Unset or rotate once bootstrap is done;
# this is a standing credential, not a one-time-use token.
SYSTEM_ACTOR_KEY=
