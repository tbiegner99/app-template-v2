meta {
  name: Admin Reset Password
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/auth/users/:id/password
  body: json
  auth: none
}

params:path {
  id: replace-with-user-id
}

body:json {
  {
    "newPassword": "NewPassword456!"
  }
}

docs {
  Requires an active session cookie — run "Sign In" first in the same run.
}
