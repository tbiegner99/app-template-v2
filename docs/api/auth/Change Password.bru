meta {
  name: Change Password
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: none
}

body:json {
  {
    "oldPassword": "Password123!",
    "newPassword": "NewPassword456!"
  }
}

docs {
  Requires an active session cookie — run "Sign In" first in the same run.
}
