meta {
  name: Sign Up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

headers {
  X-System-Actor-Key: {{systemActorKey}}
}

body:json {
  {
    "email": "test@example.com",
    "password": "Password123!",
    "displayName": "Test User",
    "roles": []
  }
}

docs {
  Requires either an authenticated admin session (Sign In first, with an
  admin-role user) or a valid X-System-Actor-Key header matching the
  backend's SYSTEM_ACTOR_KEY env var — set the "systemActorKey" environment
  variable to match for bootstrapping the first user.
}
