meta {
  name: Delete Device Token
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/v1/notifications/device-tokens/:token
  body: none
  auth: none
}

params:path {
  token: sample-fcm-token
}

docs {
  Requires an active session cookie — run "Sign In" (in the auth folder) first in the same run.
}
